// Informations de version du fournisseur MAPI (cf. mmail_mapi.c). Le numéro
// est celui du composant, pas celui de MMail : l'installeur ne remplace la
// copie de System32 / SysWOW64 que par une version plus récente, et une DLL
// chargée dans l'Explorateur ne peut pas être remplacée sans redémarrage.
// À monter à chaque changement de mmail_mapi.c.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "M-Media"
      VALUE "FileDescription", "MMail - fournisseur MAPI simple"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "MMailMAPI"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "ProductName", "MMail"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
